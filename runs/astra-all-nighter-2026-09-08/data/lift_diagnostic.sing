ring r=0,(x,y),dp;
ideal I=x+y+1,x+y+2,0;
ideal G=std(I);
matrix T=lift(I,ideal(1));
print("I:"); I;
print("T:"); T;
matrix C=I*T;
print("C:"); C;
matrix A[1][size(I)]=I;
print("A:"); A;
matrix D=A*T;
print("D:"); D;
poly v=0;
for(int j=1;j<=size(I);j++){v=v+I[j]*T[j,1];}
print("DIRECT:"); v;
quit;
